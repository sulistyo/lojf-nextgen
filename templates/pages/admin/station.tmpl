{{define "content"}}
<div class="max-w-3xl mx-auto">

  <div class="flex items-baseline justify-between mb-4">
    <div>
      <h1 class="text-2xl font-bold">Check-in — {{.Campus}}</h1>
      <p class="text-gray-600">{{.DateStr}}</p>
    </div>
    <form method="POST" action="/admin/logout">
      <button class="text-sm text-gray-500 underline">Keluar</button>
    </form>
  </div>

  {{template "flash" .}}

  {{if not .StaffName}}
    {{/* Shift gate: a shared login cannot say who is on duty, so ask once. */}}
    <div class="bg-white border rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-1">Siapa yang jaga hari ini?</h2>
      <p class="text-sm text-gray-600 mb-4">
        Nama ini dicatat di setiap check-in supaya ketahuan siapa yang menandai kehadiran.
      </p>
      <form method="POST" action="/station/staff" class="flex gap-2">
        <input name="staff_name" class="flex-1 rounded-xl border p-3 text-lg"
               placeholder="Nama kamu" autofocus required maxlength="60">
        <button class="px-5 py-3 rounded-xl bg-gray-900 text-white font-medium">Mulai</button>
      </form>
    </div>
  {{else}}

    <div class="flex items-center justify-between mb-4 text-sm">
      <span class="text-gray-700">Penjaga: <strong>{{.StaffName}}</strong></span>
      <form method="POST" action="/station/staff">
        <input type="hidden" name="staff_name" value="">
        <button class="text-gray-500 underline">Ganti penjaga</button>
      </form>
    </div>

    <form method="GET" action="/checkin" class="flex gap-2 mb-6">
      <input name="code" class="flex-1 rounded-xl border p-3 text-lg"
             placeholder="Scan QR atau ketik kode (REG-…)" autofocus>
      <button class="px-5 py-3 rounded-xl bg-gray-900 text-white font-medium">Cari</button>
    </form>

    {{if not .Classes}}
      <div class="bg-white border rounded-2xl p-6 text-gray-600">
        Tidak ada kelas hari ini untuk campus {{.Campus}}.
      </div>
    {{end}}

    {{range .Classes}}
      <div class="bg-white border rounded-2xl mb-4 overflow-hidden">
        <div class="flex items-baseline justify-between px-4 py-3 border-b bg-gray-50">
          <h2 class="font-semibold">{{.Name}}</h2>
          <span class="text-sm text-gray-600">{{.Checked}}/{{.Total}} hadir</span>
        </div>
        <ul class="divide-y">
          {{range .Kids}}
            <li class="flex items-center justify-between px-4 py-3">
              <span class="{{if .CheckInAt}}text-gray-500{{end}}">{{.ChildName}}</span>
              {{if .CheckInAt}}
                <span class="text-sm text-green-700 whitespace-nowrap">
                  ✓ {{.TimeStr}}{{if .CheckedInBy}} · {{.CheckedInBy}}{{end}}
                </span>
              {{else}}
                <form method="POST" action="/admin/registrations/{{.RegID}}/checkin">
                  <button class="px-4 py-2 rounded-xl bg-gray-900 text-white text-sm whitespace-nowrap">
                    Check in
                  </button>
                </form>
              {{end}}
            </li>
          {{end}}
        </ul>
      </div>
    {{end}}

  {{end}}
</div>
{{end}}
{{define "admin/station.tmpl"}}{{template "base" .}}{{end}}
